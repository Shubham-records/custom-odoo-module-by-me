<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Client Action for API Tester -->
    <record id="action_api_tester" model="ir.actions.client">
        <field name="name">API Tester</field>
        <field name="tag">api_request_tester.tester</field>
    </record>

    <!-- Main Menu Item (Top level like CRM) -->
    <menuitem id="menu_api_tester_root"
              name="API Tester"
              web_icon="api_request_tester,static/description/icon.png"
              sequence="10"/>

    <!-- Sub Menu Item to trigger the action -->
    <menuitem id="menu_api_tester_main"
              name="Tester"
              parent="menu_api_tester_root"
              action="action_api_tester"
              sequence="1"/>

    <!-- Client Action for API Tester Guide -->
    <record id="action_api_tester_guide" model="ir.actions.client">
        <field name="name">How to Do</field>
        <field name="tag">api_request_tester.guide</field>
    </record>

    <!-- Sub Menu Item for Guide -->
    <menuitem id="menu_api_tester_guide"
              name="How to Do"
              parent="menu_api_tester_root"
              action="action_api_tester_guide"
              sequence="45"/>
</odoo>
