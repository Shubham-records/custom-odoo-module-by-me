<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_api_folder_tree" model="ir.ui.view">
        <field name="name">api.request.folder.tree</field>
        <field name="model">api.request.folder</field>
        <field name="arch" type="xml">
            <list string="Folders">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="collection_id"/>
                <field name="parent_id"/>
            </list>
        </field>
    </record>

    <record id="view_api_folder_form" model="ir.ui.view">
        <field name="name">api.request.folder.form</field>
        <field name="model">api.request.folder</field>
        <field name="arch" type="xml">
            <form string="Folder">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Folder Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="collection_id"/>
                            <field name="parent_id"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sub-folders">
                            <field name="child_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                        <page string="Requests">
                            <field name="item_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="method"/>
                                    <field name="url"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_api_folder" model="ir.actions.act_window">
        <field name="name">Folders</field>
        <field name="res_model">api.request.folder</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_api_tester_folder"
              name="Folders"
              parent="menu_api_tester_root"
              action="action_api_folder"
              sequence="25"/>
</odoo>
