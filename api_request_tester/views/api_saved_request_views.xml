<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_api_saved_request_list" model="ir.ui.view">
        <field name="name">api.request.item.list</field>
        <field name="model">api.request.item</field>
        <field name="arch" type="xml">
            <list string="Saved Requests">
                <field name="name"/>
                <field name="collection_id"/>
                <field name="folder_id"/>
                <field name="method"/>
                <field name="url"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_api_saved_request_form" model="ir.ui.view">
        <field name="name">api.request.item.form</field>
        <field name="model">api.request.item</field>
        <field name="arch" type="xml">
            <form string="Saved Request">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Request Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="collection_id"/>
                            <field name="folder_id" domain="[('collection_id', '=', collection_id)]"/>
                        </group>
                        <group>
                            <field name="method"/>
                            <field name="url"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Parameters &amp; Headers">
                            <group>
                                <field name="query_params" string="Query Parameters (JSON)"/>
                                <field name="headers" string="Headers (JSON)"/>
                            </group>
                        </page>
                        <page string="Body">
                            <group>
                                <field name="body_type"/>
                                <field name="body" invisible="body_type == 'none'"/>
                            </group>
                        </page>
                        <page string="Authentication">
                            <group>
                                <field name="auth_type"/>
                                <field name="auth_config" string="Auth Settings (JSON)" invisible="auth_type == 'none'"/>
                            </group>
                        </page>
                        <page string="Scripts &amp; Tests">
                            <group>
                                <field name="pre_request_script" string="Pre-request Script"/>
                                <field name="assertions" string="Assertions (JSON)"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_api_saved_request_search" model="ir.ui.view">
        <field name="name">api.request.item.search</field>
        <field name="model">api.request.item</field>
        <field name="arch" type="xml">
            <search string="Search Saved Requests">
                <field name="name" string="Request Name"/>
                <field name="url" string="URL"/>
                <field name="method"/>
                <field name="collection_id"/>
                <field name="folder_id"/>

                <!-- Filters -->
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>

                <separator/>
                <filter string="GET Requests" name="get_method" domain="[('method', '=', 'GET')]"/>
                <filter string="POST Requests" name="post_method" domain="[('method', '=', 'POST')]"/>

                <!-- Group By -->
                <group>
                    <filter string="Collection" name="group_by_collection" context="{'group_by': 'collection_id'}"/>
                    <filter string="Folder" name="group_by_folder" context="{'group_by': 'folder_id'}"/>
                    <filter string="HTTP Method" name="group_by_method" context="{'group_by': 'method'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_api_saved_request" model="ir.actions.act_window">
        <field name="name">Saved Requests</field>
        <field name="res_model">api.request.item</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_api_tester_saved_requests"
              name="Saved Requests"
              parent="menu_api_tester_root"
              action="action_api_saved_request"
              sequence="5"/>
</odoo>
