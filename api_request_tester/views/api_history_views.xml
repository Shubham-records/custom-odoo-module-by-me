<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_api_history_list" model="ir.ui.view">
        <field name="name">api.request.history.list</field>
        <field name="model">api.request.history</field>
        <field name="arch" type="xml">
            <list string="API History" create="false">
                <field name="create_date"/>
                <field name="method"/>
                <field name="url"/>
                <field name="status_code"/>
                <field name="status_text"/>
                <field name="time_elapsed" widget="float_time"/>
            </list>
        </field>
    </record>

    <record id="view_api_history_form" model="ir.ui.view">
        <field name="name">api.request.history.form</field>
        <field name="model">api.request.history</field>
        <field name="arch" type="xml">
            <form string="API History" create="false">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date" readonly="1"/>
                            <field name="method" readonly="1"/>
                            <field name="url" readonly="1"/>
                        </group>
                        <group>
                            <field name="status_code" readonly="1"/>
                            <field name="status_text" readonly="1"/>
                            <field name="time_elapsed" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Request">
                            <group>
                                <field name="request_headers" readonly="1"/>
                                <field name="request_body" readonly="1"/>
                            </group>
                        </page>
                        <page string="Response">
                            <group>
                                <field name="response_headers" readonly="1"/>
                                <field name="response_body" readonly="1"/>
                            </group>
                        </page>
                        <page string="Assertions">
                            <field name="assertion_results" widget="ace" options="{'mode': 'python'}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_api_history" model="ir.actions.act_window">
        <field name="name">Request History</field>
        <field name="res_model">api.request.history</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_api_tester_history"
              name="History"
              parent="menu_api_tester_root"
              action="action_api_history"
              sequence="20"/>
</odoo>
