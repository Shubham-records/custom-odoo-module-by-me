<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- list View -->
    <record id="view_google_font_list" model="ir.ui.view">
        <field name="name">google.font.list</field>
        <field name="model">google.font</field>
        <field name="arch" type="xml">
            <list string="Google Fonts" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="font_group"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_google_font_form" model="ir.ui.view">
        <field name="name">google.font.form</field>
        <field name="model">google.font</field>
        <field name="arch" type="xml">
            <form string="Google Font">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="font_group"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_google_font" model="ir.actions.act_window">
        <field name="name">Google Fonts</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">google.font</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Add a new Google Font!
          </p><p>
            These fonts will appear in the Website Editor toolbar.
          </p>
        </field>
    </record>

    <!-- Menu Item (Configuration -> Google Fonts) -->
    <menuitem id="menu_google_font"
              name="Google Fonts"
              parent="website.menu_website_global_configuration"
              action="action_google_font"
              sequence="53"/>
</odoo>
