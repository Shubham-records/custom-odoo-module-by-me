                    <span class="lusso-hero__press-label">Featured in</span>
                    <span class="lusso-hero__press-logo">AD</span>
                    <span class="lusso-hero__press-logo">Wallpaper*</span>
                    <span class="lusso-hero__press-logo">Dezeen</span>
                </div>
            </div>
            <div class="lusso-hero__media" data-gsap="scale-in" data-gsap-delay="0.15">
                <div class="lusso-hero__image-wrap">
                    <img src="/lusso_website_snippets/static/src/img/hero-chair.png"
                         alt="The Eames Lounger"
                         class="lusso-hero__image"
                         onerror="this.style.display='none'; this.parentElement.classList.add('lusso-hero__image--placeholder')"/>
                    <div class="lusso-hero__tag" data-gsap="pop-in" data-gsap-delay="0.5">
                        <span class="lusso-hero__tag-label">NEW ARRIVAL</span>
                        <span class="lusso-hero__tag-name">The Eames Lounger</span>
                        <span class="lusso-hero__tag-price">$2,450</span>
