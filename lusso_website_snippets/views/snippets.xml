<template id="s_lusso_craft_light" name="Lusso Craftsmanship – Light">
    <section class="lusso-craft lusso-craft--light o_cc o_cc2" data-lusso-snippet="craft_light">
        <div class="container-fluid">
            <div class="lusso-craft__layout">
                <div class="lusso-craft__left">
                    <span class="lusso-craft__eyebrow" data-gsap="fade-up">OUR PHILOSOPHY</span>
                    <h2 class="lusso-craft__title" data-gsap="fade-up" data-gsap-delay="0.1">
                        The Art of<br/><em>Craftsmanship</em>
                    </h2>
                    <p class="lusso-craft__body" data-gsap="fade-up" data-gsap-delay="0.2">
                        Every piece is a testament to sustainable luxury, carved from
                        ethically sourced timber and finished by master artisans who have
                        honed their skills over generations.
                    </p>
                    <div class="lusso-craft__pillars" data-gsap="fade-up" data-gsap-delay="0.3">
                        <div class="lusso-craft__pillar">
                            <span class="lusso-craft__pillar-icon">🌲</span>
                            <div>
                                <strong>Ethically Sourced</strong>
                                <p>Wood from certified renewable forests ensuring future growth.</p>
                            </div>
                        </div>
                        <div class="lusso-craft__pillar">
                            <span class="lusso-craft__pillar-icon">🪚</span>
                            <div>
                                <strong>Hand Finished</strong>
                                <p>Oiled and polished by hand for a natural, tactile feel.</p>
                            </div>
                        </div>
                    </div>
                    <a href="#" class="lusso-btn lusso-btn--dark" data-gsap="fade-up" data-gsap-delay="0.4">Read Our Story</a>
                </div>
                <div class="lusso-craft__right" data-gsap="fade-left" data-gsap-delay="0.2">
                    <div class="lusso-craft__images">
                        <div class="lusso-craft__img-main">
                            <img src="/lusso_website_snippets/static/src/img/craft-wood.jpg" alt="Wood craftsmanship"
                                 onerror="this.parentElement.classList.add('lusso-img--placeholder'); this.style.display='none'"/>
                        </div>
                        <div class="lusso-craft__img-accent">
                            <img src="/lusso_website_snippets/static/src/img/craft-hands.jpg" alt="Artisan hands"
                                 onerror="this.parentElement.classList.add('lusso-img--placeholder'); this.style.display='none'"/>
                        </div>
                    </div>
                    <div class="lusso-craft__stats">
                        <div class="lusso-craft__stat" data-gsap="count-up">
                            <strong class="lusso-craft__stat-num" data-target="10000">10k+</strong>
                            <span>Pieces Crafted</span>
                        </div>
                        <div class="lusso-craft__stat" data-gsap="count-up" data-gsap-delay="0.1">
                            <strong class="lusso-craft__stat-num" data-target="25">25+</strong>
                            <span>Years of Heritage</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</template>

