<!-- ─────────────────────────────────────────────────────────────
     REGISTER ALL SNIPPETS IN THE WEBSITE BUILDER
     Category: "Lusso" (custom group under Blocks)
     ───────────────────────────────────────────────────────────── -->
<template id="snippets" inherit_id="website.snippets" name="Lusso Snippets">

    <!-- Add a custom Lusso group inside the snippet panel categories -->
    <xpath expr="//snippets[@id='snippet_groups']" position="inside">
        <t snippet-group="lusso" t-snippet="website.s_snippet_group" string="Lusso Blocks" t-thumbnail="/website/static/src/img/snippets_thumbs/s_text_image.svg"/>
    </xpath>

    <!-- Add all Lusso snippets to the structure, assigned to the Lusso group -->
    <xpath expr="//snippets[@id='snippet_structure']" position="inside">
        <!-- Heroes -->
        <t t-snippet="lusso_website_snippets.s_lusso_hero_light" string="Hero Light" group="lusso" t-thumbnail="/lusso_website_snippets/static/src/img/thumbs/hero_light.svg"/>
        <t t-snippet="lusso_website_snippets.s_lusso_hero_dark" string="Hero Dark" group="lusso" t-thumbnail="/lusso_website_snippets/static/src/img/thumbs/hero_dark.svg"/>
        <t t-snippet="lusso_website_snippets.s_lusso_hero_warm" string="Hero Warm" group="lusso" t-thumbnail="/lusso_website_snippets/static/src/img/thumbs/hero_warm.svg"/>
        <t t-snippet="lusso_website_snippets.s_lusso_hero_forest" string="Hero Forest" group="lusso" t-thumbnail="/lusso_website_snippets/static/src/img/thumbs/hero_forest.svg"/>

        <!-- Collections -->
        <t t-snippet="lusso_website_snippets.s_lusso_collections_light" string="Collections Light" group="lusso" t-thumbnail="/lusso_website_snippets/static/src/img/thumbs/collections_light.svg"/>
        <t t-snippet="lusso_website_snippets.s_lusso_collections_dark" string="Collections Dark" group="lusso" t-thumbnail="/lusso_website_snippets/static/src/img/thumbs/collections_dark.svg"/>

        <!-- Products -->
        <t t-snippet="lusso_website_snippets.s_lusso_products_scroll" string="Products Scroll" group="lusso" t-thumbnail="/lusso_website_snippets/static/src/img/thumbs/products_scroll.svg"/>

        <!-- Craftsmanship / Philosophy -->
        <t t-snippet="lusso_website_snippets.s_lusso_craft_light" string="Craftsmanship Light" group="lusso" t-thumbnail="/lusso_website_snippets/static/src/img/thumbs/craft_light.svg"/>
        <t t-snippet="lusso_website_snippets.s_lusso_craft_dark" string="Craftsmanship Dark" group="lusso" t-thumbnail="/lusso_website_snippets/static/src/img/thumbs/craft_dark.svg"/>

        <!-- Stats -->
        <t t-snippet="lusso_website_snippets.s_lusso_stats_light" string="Stats Light" group="lusso" t-thumbnail="/lusso_website_snippets/static/src/img/thumbs/stats_light.svg"/>
        <t t-snippet="lusso_website_snippets.s_lusso_stats_dark" string="Stats Dark" group="lusso" t-thumbnail="/lusso_website_snippets/static/src/img/thumbs/stats_dark.svg"/>

        <!-- Testimonials -->
        <t t-snippet="lusso_website_snippets.s_lusso_testimonials_light" string="Testimonials Light" group="lusso" t-thumbnail="/lusso_website_snippets/static/src/img/thumbs/testimonials_light.svg"/>

        <!-- Newsletter -->
        <t t-snippet="lusso_website_snippets.s_lusso_newsletter_light" string="Newsletter Light" group="lusso" t-thumbnail="/lusso_website_snippets/static/src/img/thumbs/newsletter_light.svg"/>
        <t t-snippet="lusso_website_snippets.s_lusso_newsletter_dark" string="Newsletter Dark" group="lusso" t-thumbnail="/lusso_website_snippets/static/src/img/thumbs/newsletter_dark.svg"/>
        <t t-snippet="lusso_website_snippets.s_lusso_newsletter_warm" string="Newsletter Warm" group="lusso" t-thumbnail="/lusso_website_snippets/static/src/img/thumbs/newsletter_warm.svg"/>

        <!-- Effects -->
        <t t-snippet="lusso_website_snippets.s_lusso_marquee" string="Marquee" group="lusso" t-thumbnail="/lusso_website_snippets/static/src/img/thumbs/marquee.svg"/>
    </xpath>
</template>

