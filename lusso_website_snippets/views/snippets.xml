<template id="s_lusso_hero_light" name="Lusso Hero – Light">
    <section class="lusso-hero lusso-hero--light o_cc o_cc1" data-lusso-snippet="hero_light">
        <div class="lusso-hero__inner container-fluid">
            <div class="lusso-hero__content">
                <span class="lusso-hero__eyebrow" data-gsap="fade-up">New Collection 2025</span>
                <h1 class="lusso-hero__title" data-gsap="fade-up" data-gsap-delay="0.1">
                    Sculpted<br/>
                    <em>Comfort</em> for<br/>
                    modern<br/>
                    living.
                </h1>
                <p class="lusso-hero__sub" data-gsap="fade-up" data-gsap-delay="0.2">
                    Experience the perfect blend of minimalist design and ergonomic luxury.
                    Handcrafted pieces that define your sanctuary.
                </p>
                <div class="lusso-hero__cta" data-gsap="fade-up" data-gsap-delay="0.3">
                    <a href="#" class="lusso-btn lusso-btn--dark">View Collection</a>
                    <a href="#" class="lusso-btn lusso-btn--ghost">
