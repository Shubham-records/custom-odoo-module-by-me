<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Google Fonts: Playfair Display + DM Sans -->
    <template id="lusso_google_fonts" inherit_id="website.layout" name="Lusso Google Fonts">
        <xpath expr="//head" position="inside">
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""/>
            <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400;1,700&amp;family=DM+Sans:wght@300;400;500;600&amp;family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&amp;family=Space+Grotesk:wght@300;400;500;600&amp;display=swap" rel="stylesheet"/>
        </xpath>
    </template>
</odoo>
